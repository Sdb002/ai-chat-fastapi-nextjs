# Copy this file to .env and fill in real values.
# Generate SECRET_KEY with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Must match TOKEN_LIFETIME_MINUTES in m2-ai-frontend/lib/auth.ts
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=sqlite:///./app.db

# Comma-separated origins allowed to call the API (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# m2d18: Groq (OpenAI-compatible). Required: the server refuses to start without it.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
